+def _assign_train_test_fraction(df: pd.DataFrame, train_fraction: float, seed: int) -> pd.DataFrame:
+    """Assign every pair to train/test using a deterministic fraction split."""
+
+    if not 0.0 < train_fraction < 1.0:
+        raise ValueError(f"train_fraction must be between 0 and 1, got {train_fraction}")
+    pair_ids = df["pair_id"].drop_duplicates().tolist()
+    if len(pair_ids) < 2:
+        raise ValueError(f"Need at least 2 pairs for a fraction split, found {len(pair_ids)}")
+
+    rng = random.Random(seed)
+    rng.shuffle(pair_ids)
+    train_count = int(round(len(pair_ids) * train_fraction))
+    train_count = min(max(train_count, 1), len(pair_ids) - 1)
+    train_set = set(pair_ids[:train_count])
+    out = df.copy()
+    out["split"] = out["pair_id"].map(lambda pair_id: "train" if pair_id in train_set else "test")
+    return out.reset_index(drop=True)
+
