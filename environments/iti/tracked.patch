+def load_truthfulqa_frame():
+    """Build the 817-row evaluation frame used by the activation dataset."""
+    generation = load_dataset('truthfulqa/truthful_qa', 'generation')['validation']
+    multiple_choice = load_dataset('truthfulqa/truthful_qa', 'multiple_choice')['validation']
+    frame = pd.DataFrame({
+        'Type': generation['type'],
+        'Category': generation['category'],
+        'Question': [question.strip() for question in generation['question']],
+        'Best Answer': generation['best_answer'],
+        'Correct Answers': ['; '.join(answers) for answers in generation['correct_answers']],
+        'Incorrect Answers': ['; '.join(answers) for answers in generation['incorrect_answers']],
+        'Source': generation['source'],
+    })
+    order = {question.strip(): index for index, question in enumerate(multiple_choice['question'])}
+    frame = frame.sort_values(
+        by='Question',
+        key=lambda values: values.map(order),
+    ).reset_index(drop=True)
+    expected = [question.strip() for question in multiple_choice['question']]
+    if list(frame['Question']) != expected:
+        raise ValueError('TruthfulQA generation and multiple-choice question sets differ')
+    return frame
+
